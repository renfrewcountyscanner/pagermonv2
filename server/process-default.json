{
  "name": "pagermon",
  "script": "./bin/www",
  "cwd": ".",
  "instances": 1,
  "exec_mode": "cluster",
  "min_uptime": "30s",
  "max_restarts": 10,
  "max_memory_restart": "512M",
  "watch": false,
  "ignore_watch": ["node_modules", "config", "logs", ".git", "coverage"],
  "merge_logs": true,
  "autorestart": true,
  "vizion": false,
  "env": {
    "NODE_ENV": "production",
    "HOSTNAME": "",
    "USE_COOKIE_HOST": false,
    "APP_NAME": "pagermon"
  },
  "env_development": {
    "NODE_ENV": "development",
    "DEBUG": "pagermon:*"
  },
  "env_test": {
    "NODE_ENV": "test"
  }
}
