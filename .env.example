# Copy to .env for Docker deployments. Do not commit .env.
# install.sh generates strong random values automatically when .env is absent.

TZ=America/Toronto
MAP_LAT=45.42
MAP_LNG=-75.70
PUBLIC_MAP_BASE_URL=http://localhost:5000
SERVER_PORT=3000
MAP_PORT=5000

PG_DATABASE=pagermon
PG_USER=pagermon
PG_PASSWORD=replace-with-a-strong-password
MAP_SECRET_KEY=replace-with-a-random-secret
PUBLIC_MAP_API_KEY=replace-with-a-shared-map-api-key

# Optional RTL-SDR client profile settings
RTL_DEVICE=0
RTL_FREQ=148.5875M
POCSAG_MODE=POCSAG512
